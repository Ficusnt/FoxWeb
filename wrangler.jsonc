{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fox-web",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "ENVIRONMENT": "production"
  },

  "kv_namespaces": [
    {
      "binding": "TABLES_KV",
      "id": "f3e43177838b4909809b17ebb2ad9ee8",
      "preview_id": ""
    }
  ],

  "assets": {
    "directory": "apps/web/dist"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "observability": {
    "enabled": true
  },

  "workers_dev": true,
  "preview_urls": true
}